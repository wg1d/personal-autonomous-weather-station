# Settings of the station, read by the backend service.
#
# On the server, this file is ~/paws/station.env. The first deployment
# creates it from this example; later deployments never change it, so the
# position of the station never goes into the repository.
#
# Remove the "#" in front of each setting and write the values of your
# station. A missing setting turns its feature off.

# The altitude of the station, in metres, for the pressure at sea level
# (0 when missing: the pressure shown is the one measured)
#PAWS_ALTITUDE_M=0

# The position of the station, in decimal degrees, north and east
# positive, for the sunrise, the sunset and the moon (no sun tile when
# missing)
#PAWS_LATITUDE=0.0
#PAWS_LONGITUDE=0.0
